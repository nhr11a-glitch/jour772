fatal_shootings_unarmed_women <- fatal_police_shootings_data |>
filter(date_new < "2020-09-03" &
gender== "female") |>
group_by(armed_with) |>
summarise(count = n()) |>
mutate(pct_total = (count/sum(count))*100) |>
arrange(desc(count))
fatal_shootings_unarmed_women |> ggplot() +
geom_bar(!is.na(armed_with),aes(x=reorder(armed_with,count), weight=count)) +
coord_flip() +
labs(title="Since 2015, police have killed 26 unarmed women",
x = "type of weapon",
y = "count",
caption = "Source: The Washington Post. Graphic created by Nicole Ramos 11/03/2025") + theme_minimal()
fatal_shootings_unarmed_women |> ggplot() +
geom_bar(aes(x=reorder(armed_with,count), weight=count)) +
coord_flip() +
remove_missing(df, na.rm = FALSE, vars = names(df), name = "", finite = FALSE)
fatal_shootings_unarmed_women |> ggplot() +
geom_bar(aes(x=reorder(armed_with,count), weight=count)) +
coord_flip() +
remove_missing(armed_with, na.rm = FALSE, vars = names(armed_with), name = "", finite = FALSE)
