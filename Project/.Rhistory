rename(population=value) |>
rename(total_population=summary_value) |>
rename(race=variable) |>
mutate(variable = case_when(str_detect(race, "P008003") ~ "White alone", str_detect(race, "P008004") ~ "Black alone")) |>
mutate(pct_population = (population/total_population)*100)
View(p10)
