knitr::opts_chunk$set(echo = TRUE)
options(scipen=999)
library(tidyverse)
library(janitor)
library(lubridate)
fatal_police_shootings_data <- read_csv("fatal-police-shootings-data.csv") %>%
clean_names() %>%
mutate(date_new = ymd(date))
