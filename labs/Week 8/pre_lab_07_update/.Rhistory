pgco_911_calls <- read_csv("data/prince_georges_2022_overdoses.csv") |>
mutate(call_date=as.Date(datetime))
pgco_911_calls <- pgco_911_calls |>
mutate(day_week=(wday(call_date,label = TRUE,
abbr = TRUE,
week_start = getOption("lubridate.week.start", 7),
locale = Sys.getlocale("LC_TIME")))) |>
mutate(month = month(call_date, label=TRUE))
View(pgco_911_calls)
pgco_911_calls_month<- pgco_911_calls |>
group_by(month) |>
summarize(total_calls = n()) |>
arrange(desc(total_calls))
View(pgco_911_calls_month)
pgco_911_calls_month |>
ggplot() +
geom_bar(aes(x=reorder(month,total_calls), weight=total_calls)) +
labs(
title="More 911 Overdose Calls in Warmer Months",
x = "month",
y = "total calls",
caption = "source: Prince George's County EMS"
)
