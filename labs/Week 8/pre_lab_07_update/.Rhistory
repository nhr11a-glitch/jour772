pgco_911_calls <- read_csv("data/prince_georges_2022_overdoses.csv") |>
mutate(call_date=as.Date(datetime))
pgco_911_calls <- pgco_911_calls |>
mutate(week = floor_date(call_date, "week"))  |>
mutate(month = month(call_date, label=TRUE))
pgco_911_calls_month<- pgco_911_calls |>
group_by(month) |>
summarize(total_calls = n()) |>
mutate(pct_total_calls= (total_calls/sum(total_calls))*100)
pgco_911_calls_month |>
ggplot() +
geom_bar(aes(x=reorder(month,pct_total_calls), weight=pct_total_calls)) +
labs(
title="911 Calls Peak Around the Holiday Season",
x = "Month",
y = "Percent of Total Calls",
caption = "Source: Prince George's County EMS"
)
pgco_911_calls_week<- pgco_911_calls |>
group_by(week) |>
summarize(total_calls = n()) |>
arrange(desc(total_calls))
pgco_911_calls_week |>
ggplot() +
geom_line(aes(x=week, y=total_calls)) +
scale_x_date(date_breaks = "4 week", date_labels = "%b %d") +
theme(
axis.text.x = element_text(angle = 45,  hjust=1)) +
labs(
title="911 Calls Spike the Week of Fourth of July",
x = "Week",
y = "Total Calls",
caption = "Source: Prince George's County EMS")
