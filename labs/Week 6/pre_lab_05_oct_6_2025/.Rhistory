knitr::opts_chunk$set(echo = TRUE)
# Turn off scientific notation
options(scipen=999)
# Load the tidyverse, plus any other packages you will need to clean data and work with dates.
library(tidyverse)
library(janitor)
library(lubridate)
Baltimore_calls <- read_csv("tabula-Baltimore County; Carey, Samantha log OD.csv", col_names = FALSE) |>
clean_names() |>
rename(date = x1,
date_time = x2,
case_number = x3,
event_type = x4,
location = x5) |>
mutate(date=mdy(date))
View(Baltimore_calls)
Baltimore_calls |>
group_by(date) |>
summarize(count = n()) |>
arrange(desc(count))
Baltimore_calls |>
filter(str_detect(date, regex("2022"))) |>
group_by(date) |>
summarize(count = n()) |>
arrange(desc(count))
Baltimore_calls <- Baltimore_calls |>
mutate(day_week=
(wday(date,label = TRUE,
abbr = TRUE,
week_start = getOption("lubridate.week.start", 7),
locale = Sys.getlocale("LC_TIME"))))
View(Baltimore_calls)
Baltimore_calls_totals <- Baltimore_calls |>
group_by(day_week) |>
summarize(count = n()) |>
mutate(pct_calls = count/sum(count)*100) |>
arrange(desc(count))
View(Baltimore_calls_totals)
Baltimore_calls |>
group_by(location) |>
summarize(count = n()) |>
arrange(desc(count))
Baltimore_calls |>
filter((str_detect(location, "PC ")))
